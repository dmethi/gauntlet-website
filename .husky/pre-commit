echo "🔍 Running pre-commit checks..."

# Check if there are any staged files
if git diff --staged --quiet; then
  echo "No staged files found."
  exit 0
fi

echo "📝 Formatting staged files with Prettier..."
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -n 50 sh -c '
  set -e
  [ "$#" -eq 0 ] && exit 0
  pnpm exec prettier --write --ignore-unknown -- "$@"
  git add -- "$@"
' sh

echo "🔎 Running ESLint..."
pnpm lint

echo "🔧 Type checking with TypeScript..."
pnpm type-check

echo "✅ All pre-commit checks passed!"
