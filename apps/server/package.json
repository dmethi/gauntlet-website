{
  "name": "@gauntlet/server",
  "version": "0.1.0",
  "description": "Background jobs for Gauntlet - live odds capture and historical tracking",
  "private": true,
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "prisma generate --schema=prisma/schema-historical.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema-historical.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema-historical.prisma",
    "live-snapshot": "tsx src/scripts/jobs/comprehensive-live-snapshot.ts",
    "update-variance": "tsx src/scripts/jobs/update-variance-models.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "prisma": {
    "schema": "prisma/schema-historical.prisma"
  },
  "dependencies": {
    "@gauntlet/lib": "workspace:*",
    "@gauntlet/sim-engine": "workspace:*",
    "@gauntlet/types": "workspace:*",
    "@prisma/client": "^5.0.0",
    "dotenv": "^16.4.5",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "nodemon": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
