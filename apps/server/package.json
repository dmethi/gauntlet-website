{
  "name": "@gauntlet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "rollups:compute": "tsx src/scripts/analysis/compute-weekly-rollups.ts",
    "ingest:all": "tsx src/scripts/data-ingestion/index.ts",
    "ingest:current": "tsx src/scripts/ingest-current-season.ts",
    "superlatives:compute": "tsx src/scripts/analysis/compute-season-superlatives.ts",
    "live-sims": "tsx src/scripts/jobs/run-live-sims.ts",
    "batch-sims": "tsx src/scripts/jobs/run-batch-simulations.ts",
    "batch-sims:optimized": "tsx src/scripts/jobs/run-batch-simulations-optimized.ts",
    "regression:matchup": "tsx src/scripts/regression/run-matchup-sim.ts",
    "readiness:variance": "tsx src/scripts/readiness/check-variance-coverage.ts",
    "metrics:calc": "tsx src/scripts/metrics/run-calc.ts",
    "hydrate:weekly": "tsx src/scripts/hydrate-weekly-metrics.ts",
    "seed:livewin": "tsx src/scripts/seed-live-winprob.ts",
    "inventory:db": "tsx src/scripts/inventory-db.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@gauntlet/lib": "workspace:*",
    "@gauntlet/sim-engine": "workspace:*",
    "@prisma/client": "^5.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.20",
    "@types/node": "^18.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
