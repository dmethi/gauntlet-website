generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  username     String        @unique
  displayName  String
  avatar       String?
  metadata     Json?
  isBot        Boolean       @default(false)
  rosters      Roster[]      @relation("RosterOwners")
  transactions Transaction[] @relation("TransactionCreator")
  leagues      League[]      @relation("LeagueOwners")

  @@index([username])
}

model League {
  id                   String                @id
  name                 String
  season               String
  seasonType           String                @default("regular")
  status               String                @default("pre_draft")
  sport                String                @default("nfl")
  totalRosters         Int
  settings             Json?
  scoringSettings      Json?
  rosterPositions      String[]
  metadata             Json?
  previousLeagueId     String?
  draftId              String?
  playoffMatchups      Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  drafts               Draft[]
  hallOfFameRecords    HallOfFameRecord[]
  leagueWeekSummaries  LeagueWeekSummary[]
  matchups             Matchup[]
  matchupOddsHistory   MatchupOddsHistory[]
  matchupSimulations   MatchupSimulation[]
  matchupSummaries     MatchupSummary[]
  rosters              Roster[]
  rosterWeekAggregates RosterWeekAggregate[]
  seasonSuperlatives   SeasonSuperlatives[]
  tradedPicks          TradedPick[]
  transactions         Transaction[]
  weeklyMetrics        WeeklyMetrics[]
  users                User[]                @relation("LeagueOwners")

  @@index([season])
}

model Roster {
  id                         Int                   @id
  leagueId                   String
  ownerId                    String?
  coOwners                   String[]
  players                    String[]
  starters                   String[]
  reserve                    String[]
  settings                   Json?
  metadata                   Json?
  waiverBudget               Int                   @default(100)
  waiverPosition             Int?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  hallOfFameRecords          HallOfFameRecord[]
  matchups                   Matchup[]
  matchupSummariesAsA        MatchupSummary[]      @relation("MatchupSummaryRosterA")
  matchupSummariesAsB        MatchupSummary[]      @relation("MatchupSummaryRosterB")
  league                     League                @relation(fields: [leagueId], references: [id])
  owner                      User?                 @relation("RosterOwners", fields: [ownerId], references: [id])
  asOpponentInWeekAggregates RosterWeekAggregate[] @relation("RosterWeekOpponent")
  weekAggregates             RosterWeekAggregate[]
  seasonSuperlatives         SeasonSuperlatives[]
  tradedPicks                TradedPick[]          @relation("CurrentOwner")
  weeklyMetrics              WeeklyMetrics[]

  @@index([leagueId])
  @@index([ownerId])
}

model Matchup {
  id             String   @id @default(cuid())
  leagueId       String
  week           Int
  rosterId       Int
  matchupId      Int?
  points         Float    @default(0)
  customPoints   Float?
  starters       String[]
  startersPoints Json?
  players        String[]
  playersPoints  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  league         League   @relation(fields: [leagueId], references: [id])
  roster         Roster   @relation(fields: [rosterId], references: [id])

  @@unique([leagueId, week, rosterId])
  @@index([leagueId, week])
}

model Transaction {
  id            String    @id
  leagueId      String
  type          String
  status        String    @default("pending")
  creatorId     String
  rosterIds     Int[]
  adds          Json?
  drops         Json?
  draftPicks    Json?
  waiver        Json?
  settings      Json?
  leg           Int       @default(1)
  consenterIds  String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  transactionAt DateTime?
  creator       User      @relation("TransactionCreator", fields: [creatorId], references: [id])
  league        League    @relation(fields: [leagueId], references: [id])

  @@index([leagueId])
  @@index([creatorId])
}

model TradedPick {
  id              String   @id @default(cuid())
  leagueId        String
  season          String
  round           Int
  rosterId        Int
  previousOwnerId Int?
  ownerId         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  league          League   @relation(fields: [leagueId], references: [id])
  currentOwner    Roster   @relation("CurrentOwner", fields: [ownerId], references: [id])

  @@index([leagueId, season])
  @@index([ownerId])
}

model Draft {
  id             String      @id
  leagueId       String
  status         String      @default("pre_draft")
  type           String      @default("snake")
  season         String
  settings       Json
  metadata       Json?
  slotToRosterId Int[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  league         League      @relation(fields: [leagueId], references: [id])
  picks          DraftPick[]

  @@index([leagueId])
}

model DraftPick {
  id        String   @id @default(cuid())
  draftId   String
  pickNo    Int
  round     Int
  rosterId  Int
  playerId  String
  pickedBy  String?
  metadata  Json?
  isKeeper  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  draft     Draft    @relation(fields: [draftId], references: [id])

  @@unique([draftId, pickNo])
  @@index([draftId])
  @@index([rosterId])
}

model Player {
  id              String                @id
  hashtag         String?
  firstName       String
  lastName        String
  fullName        String
  team            String?
  position        String
  depthChartOrder Int?
  status          String?
  injuryStatus    String?
  weight          String?
  height          String?
  number          Int?
  age             Int?
  yearsExp        Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  statusHistory   PlayerStatusHistory[]

  @@index([position])
  @@index([team])
}

model PlayerStats {
  id        String   @id @default(cuid())
  playerId  String
  week      Int
  season    String
  statsType String
  stats     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, week, season, statsType])
  @@index([playerId])
  @@index([week, season])
}

model WeeklyMetrics {
  id             String   @id @default(cuid())
  leagueId       String
  rosterId       Int
  week           Int
  totalPoints    Float
  expectedWins   Float
  luckRating     Float
  opponentPoints Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  league         League   @relation(fields: [leagueId], references: [id])
  roster         Roster   @relation(fields: [rosterId], references: [id])

  @@unique([leagueId, rosterId, week])
  @@index([leagueId, week])
  @@index([rosterId, week])
}

model PositionVariance {
  id          String   @id @default(cuid())
  position    String
  season      String
  sampleSize  Int
  meanError   Float
  stdDev      Float
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([position, season])
  @@index([position])
}

model PlayerVariance {
  id          String   @id @default(cuid())
  playerId    String
  season      String
  sampleSize  Int
  meanError   Float
  stdDev      Float
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([playerId, season])
  @@index([playerId])
}

model ProjectionError {
  id              String   @id @default(cuid())
  playerId        String
  week            Int
  season          String
  projectedPoints Float
  actualPoints    Float
  normalizedError Float
  createdAt       DateTime @default(now())

  @@unique([playerId, week, season])
  @@index([playerId])
  @@index([season, week])
}

model MatchupSummary {
  id             String   @id @default(cuid())
  leagueId       String
  week           Int
  matchupId      Int
  rosterAId      Int
  rosterBId      Int
  pointsA        Float
  pointsB        Float
  winnerRosterId Int?
  margin         Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  league         League   @relation(fields: [leagueId], references: [id])
  rosterA        Roster   @relation("MatchupSummaryRosterA", fields: [rosterAId], references: [id])
  rosterB        Roster   @relation("MatchupSummaryRosterB", fields: [rosterBId], references: [id])

  @@unique([leagueId, week, matchupId])
  @@index([leagueId, week])
}

model RosterWeekAggregate {
  id                       String   @id @default(cuid())
  leagueId                 String
  rosterId                 Int
  week                     Int
  points                   Float    @default(0)
  projectedPoints          Float?
  optimalPoints            Float?
  managerDelta             Float?
  managerScore             Float?
  opponentRosterId         Int?
  opponentPoints           Float?
  won                      Boolean?
  streak                   Int?
  rollingAvg3              Float?
  expectedWins             Float?
  luck                     Float?
  positionalPoints         Json?
  opponentPositionalPoints Json?
  mvpPlayerId              String?
  mvpValue                 Float?
  transactionScore         Float?
  injuryPoints             Float?
  powerRank                Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  boomCount                Int?
  bustCount                Int?
  donutCount               Int?
  starConcentrationIndex   Float?
  league                   League   @relation(fields: [leagueId], references: [id])
  opponent                 Roster?  @relation("RosterWeekOpponent", fields: [opponentRosterId], references: [id])
  roster                   Roster   @relation(fields: [rosterId], references: [id])

  @@unique([leagueId, rosterId, week])
  @@index([leagueId, week])
  @@index([rosterId, week])
}

model LeagueWeekSummary {
  id            String   @id @default(cuid())
  leagueId      String
  week          Int
  medianPoints  Float
  averagePoints Float
  maxPoints     Float
  minPoints     Float
  stdDev        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  league        League   @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, week])
  @@index([leagueId, week])
}

model PlayerStatusHistory {
  id           String   @id @default(cuid())
  playerId     String
  season       String
  week         Int
  status       String?
  injuryStatus String?
  source       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  player       Player   @relation(fields: [playerId], references: [id])

  @@unique([playerId, season, week])
  @@index([season, week])
}

model SeasonSuperlatives {
  id        String   @id @default(cuid())
  leagueId  String
  season    String
  category  String
  week      Int?
  rosterId  Int?
  playerId  String?
  matchupId Int?
  value     Float?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  league    League   @relation(fields: [leagueId], references: [id])
  roster    Roster?  @relation(fields: [rosterId], references: [id])

  @@index([leagueId, season])
  @@index([category])
}

/// Live win probability and score snapshots during games (every ~10 minutes)
model LiveWinProbSample {
  id              String   @id @default(cuid())
  leagueId        String
  week            Int
  matchupId       Int
  rosterAId       Int
  rosterBId       Int
  timestamp       DateTime @default(now())
  gameProgress    Float
  winProbA        Float
  winProbB        Float
  projectedFinalA Float
  projectedFinalB Float
  currentScoreA   Float
  currentScoreB   Float
  spread          Float
  total           Float

  @@index([leagueId, week, matchupId])
  @@index([timestamp])
}

/// Defines all trackable stat categories for Hall of Fame/Shame
model HallOfFameCategory {
  id          String             @id @default(cuid())
  name        String             @unique
  displayName String
  description String?
  groupName   String
  statType    String
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  records     HallOfFameRecord[]

  @@index([groupName])
  @@index([statType])
}

/// Individual Hall of Fame/Shame records (top 5/bottom 5 for each category)
model HallOfFameRecord {
  id          String             @id @default(cuid())
  categoryId  String
  leagueId    String
  rosterId    Int
  week        Int
  season      String
  value       Float
  recordType  String
  rank        Int
  contextData Json?
  isAllTime   Boolean            @default(false)
  achievedAt  DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  category    HallOfFameCategory @relation(fields: [categoryId], references: [id])
  league      League             @relation(fields: [leagueId], references: [id])
  roster      Roster             @relation(fields: [rosterId], references: [id])

  @@unique([categoryId, leagueId, recordType, rank])
  @@index([leagueId, season])
  @@index([categoryId, recordType, rank])
  @@index([rosterId])
}

model MatchupSimulation {
  id                String             @id @default(cuid())
  leagueId          String
  week              Int
  matchupId         Int
  teamAMean         Float
  teamAP10          Float
  teamAP25          Float?
  teamAMedian       Float
  teamAP75          Float?
  teamAP90          Float
  teamAStdDev       Float
  teamBMean         Float
  teamBP10          Float
  teamBP25          Float?
  teamBMedian       Float
  teamBP75          Float?
  teamBP90          Float
  teamBStdDev       Float
  teamAWinPct       Float
  teamBWinPct       Float
  impliedSpread     Float
  moneyLineA        Int
  moneyLineB        Int
  totalLine         Float
  overPct           Float
  underPct          Float
  iterations        Int                @default(100000)
  simulationSeed    Int?
  computeTimeMs     Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  league            League             @relation(fields: [leagueId], references: [id])
  playerSimulations PlayerSimulation[]

  @@unique([leagueId, week, matchupId])
  @@index([leagueId, week])
  @@index([createdAt])
}

model PlayerSimulation {
  id                  String            @id @default(cuid())
  matchupSimulationId String
  playerId            String
  playerName          String
  position            String
  teamRosterId        Int
  isStarter           Boolean
  mean                Float
  p10                 Float
  p25                 Float?
  median              Float
  p75                 Float?
  p90                 Float
  stdDev              Float
  projection          Float
  dataSource          String
  sampleSize          Int?
  createdAt           DateTime          @default(now())
  matchupSimulation   MatchupSimulation @relation(fields: [matchupSimulationId], references: [id], onDelete: Cascade)

  @@unique([matchupSimulationId, playerId])
  @@index([playerId])
}

model MatchupOddsHistory {
  id             String   @id @default(cuid())
  leagueId       String
  week           Int
  matchupId      Int
  team1WinPct    Float
  team2WinPct    Float
  spread         Float
  total          Float
  team1MoneyLine Int
  team2MoneyLine Int
  gameProgress   Float
  isLive         Boolean  @default(false)
  triggeredBy    String
  computeTimeMs  Int?
  createdAt      DateTime @default(now())
  team1Score     Float?
  team2Score     Float?
  league         League   @relation(fields: [leagueId], references: [id])

  @@index([leagueId, week, matchupId])
  @@index([createdAt])
  @@index([isLive])
}

model LeagueOddsHistory {
  id                    String   @id @default(cuid())
  week                  Int
  highestScorerOdds     Json
  lowestScorerOdds      Json
  closestMatchup        Json
  biggestBlowout        Json
  isLive                Boolean  @default(false)
  triggeredBy           String
  computeTimeMs         Int?
  createdAt             DateTime @default(now())
  highestScoringMatchup Json     @default("[]")
  lowestScoringMatchup  Json     @default("[]")

  @@index([week])
  @@index([createdAt])
  @@index([isLive])
}
