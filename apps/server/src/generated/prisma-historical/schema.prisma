// Minimal Prisma Schema - Historical Data Only
// Database stores ONLY time-series data that Sleeper API doesn't provide
// Everything else uses Sleeper API directly (see apps/web/src/lib/api-replacements.ts)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-historical"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Live win probability samples captured during NFL games
/// Purpose: Time-series charts showing how win probability changed during games
/// Written by: .github/workflows/live-odds-updates.yml (every 10 min during games)
/// Used by: Weekly recap reports, matchup excitement metrics
model LiveWinProbSample {
  id              String   @id @default(cuid())
  leagueId        String
  week            Int
  matchupId       Int
  rosterAId       Int
  rosterBId       Int
  timestamp       DateTime @default(now())
  gameProgress    Float
  winProbA        Float
  winProbB        Float
  projectedFinalA Float
  projectedFinalB Float
  currentScoreA   Float
  currentScoreB   Float
  spread          Float
  total           Float

  @@index([leagueId, week, matchupId])
  @@index([timestamp])
}

/// Historical odds for individual matchups
/// Purpose: Track how matchup odds changed over time
/// Written by: .github/workflows/live-odds-updates.yml (during games)
/// Used by: Matchup history charts, odds movement analysis
model MatchupOddsHistory {
  id             String   @id @default(cuid())
  leagueId       String
  week           Int
  matchupId      Int
  team1WinPct    Float
  team2WinPct    Float
  spread         Float
  total          Float
  team1MoneyLine Int
  team2MoneyLine Int
  gameProgress   Float
  isLive         Boolean  @default(false)
  triggeredBy    String
  computeTimeMs  Int?
  createdAt      DateTime @default(now())
  team1Score     Float?
  team2Score     Float?

  @@index([leagueId, week, matchupId])
  @@index([createdAt])
  @@index([isLive])
}

/// League-wide odds snapshots
/// Purpose: Track league-wide predictions (highest scorer, closest matchup, etc.)
/// Written by: .github/workflows/live-odds-updates.yml
/// Used by: Weekly recap reports, league-wide trends
model LeagueOddsHistory {
  id                    String   @id @default(cuid())
  week                  Int
  highestScorerOdds     Json
  lowestScorerOdds      Json
  closestMatchup        Json
  biggestBlowout        Json
  highestScoringMatchup Json     @default("[]")
  lowestScoringMatchup  Json     @default("[]")
  isLive                Boolean  @default(false)
  triggeredBy           String
  computeTimeMs         Int?
  createdAt             DateTime @default(now())

  @@index([week])
  @@index([createdAt])
  @@index([isLive])
}
