{
  "name": "@gauntlet/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "cd ../server && npx prisma generate --schema=prisma/schema-historical.prisma && cd ../web && npx prisma generate --schema=prisma/schema.prisma",
    "start": "next start",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:multi-league": "vitest run src/__tests__/integration/multi-league.test.ts src/__tests__/integration/data-flow.test.ts",
    "test:recap-orchestrator": "tsx scripts/test-recap-orchestrator.ts",
    "test:recap-orchestration": "tsx scripts/test-recap-orchestration.ts",
    "test:dynamic-reports": "tsx scripts/test-dynamic-reports.ts",
    "test:storage": "tsx scripts/test-storage.ts",
    "test:storage-integration": "tsx scripts/test-storage-integration.ts",
    "test:gemini-api": "tsx scripts/test-gemini-api.ts",
    "test:tool-framework": "tsx scripts/test-tool-framework.ts",
    "test:prompt-system": "tsx scripts/test-prompt-system.ts",
    "test:types-schemas": "tsx scripts/test-types-schemas.ts",
    "test:league-overview": "tsx scripts/test-league-overview-section.ts",
    "test:username-mapping": "tsx scripts/test-username-mapping.ts",
    "test:game-flow": "tsx scripts/test-game-flow-compression.ts",
    "test:game-flow-tool": "tsx scripts/test-game-flow-tool-registry.ts",
    "test:matchup-data": "tsx scripts/test-matchup-data-tools.ts",
    "test:matchup-narrative": "tsx scripts/test-matchup-narrative.ts",
    "test:batch-matchups": "tsx scripts/test-batch-matchup-narratives.ts",
    "test:hall-of-fame": "tsx scripts/test-hall-of-fame-enhanced.ts",
    "test:power-rankings": "tsx scripts/test-power-rankings.ts",
    "test:standings": "tsx scripts/test-standings.ts",
    "test:upcoming": "tsx scripts/test-upcoming.ts",
    "test:closing": "tsx scripts/test-closing-commentary.ts",
    "test:report-list": "tsx scripts/test-report-list.ts",
    "test:cron-recap": "tsx scripts/test-cron-recap.ts",
    "generate:usernames": "tsx scripts/generate-username-mapping.ts",
    "check:week5-data": "tsx scripts/check-week5-game-flow-data.ts",
    "precompute": "npx tsx src/scripts/precompute-analytics.ts",
    "precompute:real": "npx tsx src/scripts/precompute-real-analytics.ts",
    "precompute:dev": "npm run precompute && npm run dev",
    "precompute:real-dev": "npm run precompute:real && npm run dev"
  },
  "dependencies": {
    "@gauntlet/lib": "workspace:*",
    "@gauntlet/server": "workspace:*",
    "@gauntlet/sim-engine": "workspace:*",
    "@gauntlet/types": "workspace:*",
    "@gauntlet/ui": "workspace:*",
    "@langchain/core": "^0.3.78",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^0.4.9",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@types/d3": "^7.4.3",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.1.0",
    "autoprefixer": "^10.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.323.0",
    "next": "14.1.0",
    "next-themes": "^0.2.1",
    "postcss": "^8",
    "react": "^18",
    "react-content-loader": "^7.1.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12",
    "@prisma/client": "^5.17.0"
  },
  "devDependencies": {
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.17.0",
    "@testing-library/jest-dom": "6.1.5",
    "@testing-library/react": "14.0.0",
    "@testing-library/user-event": "14.5.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "vite": "^6.0.7",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.36.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "happy-dom": "12.10.3",
    "prettier": "3.6.2",
    "prisma": "^5.17.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
