{
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@gauntlet/web",
  "devCommand": "cd ../.. && pnpm dev --filter=@gauntlet/web",
  "installCommand": "cd ../.. && pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "src/app/api/**/route.{js,ts}": {
      "maxDuration": 30
    },
    "src/app/api/cron/live-odds/route.{js,ts}": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 0-5 * 9-12,1-2 5"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 0-5 * 9-12,1-2 6"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 17-23 * 12,1 6"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 0-5 * 12,1 0"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 17-21 * 9-12,1-2 0"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 20-23 * 9-12,1-2 0"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 0-5 * 9-12,1-2 1"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "*/10 0-5 * 9-12,1-2 2"
    },
    {
      "path": "/api/cron/live-odds",
      "schedule": "0 10 * 9-12,1-2 *"
    }
  ]
}
